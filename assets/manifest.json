{
  "models": [
    {
      "source": "models/gltf/cube/cube-tex.glb",
      "output": "models/cube.spnga"
    },
    {
      "source": "models/gltf/helmet/DamagedHelmet.glb",
      "output": "models/helmet.spnga"
    },
    {
      "source": "models/gltf/sponza/sponza.glb",
      "output": "models/sponza.spnga"
    }
  ],
  "textures": [
    {
      "source": "textures/blackcoffee.png",
      "output": "textures/blackcoffee.ktx2"
    }
  ],
  "atlases": [
    {
      "output": "textures/ui.ktx2",
      "sprites": {
        "keyboard_arrows_horizontal": "textures/prompts/keyboard_arrows_horizontal.png",
        "keyboard_arrows_vertical": "textures/prompts/keyboard_arrows_vertical.png",
        "keyboard_e": "textures/prompts/keyboard_e.png",
        "keyboard_enter": "textures/prompts/keyboard_enter.png",
        "keyboard_escape": "textures/prompts/keyboard_escape.png",
        "keyboard_q": "textures/prompts/keyboard_q.png",
        "xbox_button_a": "textures/prompts/xbox_button_a.png",
        "xbox_button_b": "textures/prompts/xbox_button_b.png",
        "xbox_dpad_horizontal": "textures/prompts/xbox_dpad_horizontal.png",
        "xbox_dpad_vertical": "textures/prompts/xbox_dpad_vertical.png",
        "xbox_lb": "textures/prompts/xbox_lb.png",
        "xbox_rb": "textures/prompts/xbox_rb.png"
      }
    }
  ],
  "shaders": {
    "output": "shaders.spnga",
    "stages": {
      "screenquad.vert": "shaders/slang/fxaa.slang:vertMain",
      "pbr.frag": "shaders/slang/pbr.slang:fragMain",
      "pbr.vert": "shaders/slang/pbr.slang:vertMain",
      "shadowmap.frag": "shaders/slang/shadowmap.slang:fragMain",
      "shadowmap_evsm.frag": "shaders/slang/shadowmap.slang:fragMainEVSM",
      "shadowmap.vert": "shaders/slang/shadowmap.slang:vertMain",
      "blur.frag": "shaders/slang/blur.slang:downFragMain",
      "blur_up.frag": "shaders/slang/blur.slang:upFragMain",
      "bloom_down.frag": "shaders/slang/bloom.slang:downFragMain",
      "bloom_extract.frag": "shaders/slang/bloom.slang:extractFragMain",
      "bloom_up.frag": "shaders/slang/bloom.slang:upFragMain",
      "fxaa.frag": "shaders/slang/fxaa.slang:fragMain",
      "tonemap.frag": "shaders/slang/tonemap.slang:fragMain",
      "taa_resolve.frag": "shaders/slang/taa.slang:resolveFragMain",
      "taa_present.frag": "shaders/slang/taa.slang:presentFragMain",
      "quad.frag": "shaders/slang/rectangle.slang:fragMain",
      "quad.vert": "shaders/slang/rectangle.slang:vertMain",
      "sprite.frag": "shaders/slang/sprite.slang:fragMain",
      "text.frag": "shaders/slang/sprite.slang:textFragMain",
      "sprite.vert": "shaders/slang/sprite.slang:vertMain",
      "cube.frag": "shaders/slang/cube.slang:fragMain",
      "cube.vert": "shaders/slang/cube.slang:vertMain",
      "depthprepass.vert": "shaders/slang/depthprepass.slang:vertMain",
      "depthprepass.frag": "shaders/slang/depthprepass.slang:fragMain",
      "cluster_assign.comp": "shaders/slang/cluster_assign.slang:csMain"
    }
  }
}
